{
  // In VS Code: press Cmd+Shift+B (or Terminal > Run Build Task) to start Swell.
  // It opens http://localhost:5050 in your browser. Press Ctrl+C in the terminal panel to stop.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Swell",
      "type": "shell",
      "command": "bash start-swell.command",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Start Swell with a new Gemini key",
      "type": "shell",
      "command": "bash start-swell.command --new-key",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    }
  ]
}
